# Copy to .env.local for local development (`npm run dev`). .env.local is git-ignored (*.local).
#
# Vite load order for a production build: .env.production.local > .env.production > .env.local > .env
# so `npm run build` always uses .env.production (the live project), even if .env.local exists.
#
# Both values are PUBLIC (they end up in the browser bundle). Secrets such as the service-role key,
# RESEND_API_KEY or SMTP passwords belong in Supabase Edge Function secrets, never here.
# If either variable is missing, src/supabase.tsx falls back to the production values.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
