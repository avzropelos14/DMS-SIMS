//admin part

{(['Active', 'Graduate', 'Dropped', 'Transferred'] as StudentStatus[]).map(tab => (
          <button
            key={tab}
            onClick={() => setActiveTab(tab)}
            className={`flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold border-2 transition-all ${activeTab === tab ? 'border-[#1a2b4a] bg-[#1a2b4a] text-white' : 'border-gray-200 text-[#6b6456] bg-white hover:border-[#1a2b4a]/30'}`}
          >
            <span>{tab}</span>
            <span className={`text-xs px-1.5 py-0.5 rounded-full font-bold ${activeTab === tab ? 'bg-white/25 text-white' : 'bg-gray-100 text-[#6b6456]'}`}>{counts[tab]}</span>
          </button>
        ))}